{
  "html": "<div><span class=\"tok-comment\">// Places cells in columns round-robin (left to right, in index order)</span><span class=\"\"></span></div>\n<div><span class=\"\"></span><span class=\"tok-comment\">// rather than always choosing the shortest column</span><span class=\"\"></span></div>\n<div><span class=\"\"></span><span class=\"tok-keyword\">function</span><span class=\"\"> </span><span class=\"tok-variableName tok-definition\">createRoundRobinPositioner</span><span class=\"tok-punctuation\">(</span><span class=\"tok-variableName tok-definition\">columnCount</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-typeName\">number</span><span class=\"tok-punctuation\">,</span><span class=\"\"> </span><span class=\"tok-variableName tok-definition\">columnWidth</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-typeName\">number</span><span class=\"tok-punctuation\">)</span><span class=\"\"> </span><span class=\"tok-punctuation\">{</span><span class=\"\"></span></div>\n<div><span class=\"\">  </span><span class=\"tok-keyword\">let</span><span class=\"\"> </span><span class=\"tok-variableName tok-definition\">columnHeights</span><span class=\"\"> </span><span class=\"tok-operator\">=</span><span class=\"\"> </span><span class=\"tok-keyword\">new</span><span class=\"\"> </span><span class=\"tok-variableName\">Array</span><span class=\"\">&#60;</span><span class=\"tok-typeName\">number</span><span class=\"\">&#62;</span><span class=\"tok-punctuation\">(</span><span class=\"tok-variableName\">columnCount</span><span class=\"tok-punctuation\">)</span><span class=\"tok-operator\">.</span><span class=\"tok-propertyName\">fill</span><span class=\"tok-punctuation\">(</span><span class=\"tok-number\">0</span><span class=\"tok-punctuation\">)</span><span class=\"tok-punctuation\">;</span><span class=\"\"></span></div>\n<div>&nbsp;</div>\n<div><span class=\"\">  </span><span class=\"tok-keyword\">function</span><span class=\"\"> </span><span class=\"tok-variableName tok-definition\">cellPositioner</span><span class=\"tok-punctuation\">(</span><span class=\"tok-variableName tok-definition\">index</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-typeName\">number</span><span class=\"tok-punctuation\">)</span><span class=\"\"> </span><span class=\"tok-punctuation\">{</span><span class=\"\"></span></div>\n<div><span class=\"\">    </span><span class=\"tok-keyword\">const</span><span class=\"\"> </span><span class=\"tok-variableName tok-definition\">column</span><span class=\"\"> </span><span class=\"tok-operator\">=</span><span class=\"\"> </span><span class=\"tok-variableName\">index</span><span class=\"\"> </span><span class=\"tok-operator\">%</span><span class=\"\"> </span><span class=\"tok-variableName\">columnCount</span><span class=\"tok-punctuation\">;</span><span class=\"\"></span></div>\n<div><span class=\"\">    </span><span class=\"tok-keyword\">const</span><span class=\"\"> </span><span class=\"tok-variableName tok-definition\">left</span><span class=\"\"> </span><span class=\"tok-operator\">=</span><span class=\"\"> </span><span class=\"tok-variableName\">column</span><span class=\"\"> </span><span class=\"tok-operator\">*</span><span class=\"\"> </span><span class=\"tok-variableName\">columnWidth</span><span class=\"tok-punctuation\">;</span><span class=\"\"></span></div>\n<div><span class=\"\">    </span><span class=\"tok-keyword\">const</span><span class=\"\"> </span><span class=\"tok-variableName tok-definition\">top</span><span class=\"\"> </span><span class=\"tok-operator\">=</span><span class=\"\"> </span><span class=\"tok-variableName\">columnHeights</span><span class=\"tok-punctuation\">[</span><span class=\"tok-variableName\">column</span><span class=\"tok-punctuation\">]</span><span class=\"tok-punctuation\">;</span><span class=\"\"></span></div>\n<div>&nbsp;</div>\n<div><span class=\"\">    </span><span class=\"tok-comment\">// Sizes have already been measured (and cached) by the time a cell is positioned</span><span class=\"\"></span></div>\n<div><span class=\"\">    </span><span class=\"tok-variableName\">columnHeights</span><span class=\"tok-punctuation\">[</span><span class=\"tok-variableName\">column</span><span class=\"tok-punctuation\">]</span><span class=\"\"> </span><span class=\"tok-operator\">=</span><span class=\"\"> </span><span class=\"tok-variableName\">top</span><span class=\"\"> </span><span class=\"tok-operator\">+</span><span class=\"\"> </span><span class=\"tok-variableName\">cache</span><span class=\"tok-operator\">.</span><span class=\"tok-propertyName\">getHeight</span><span class=\"tok-punctuation\">(</span><span class=\"tok-variableName\">index</span><span class=\"tok-punctuation\">)</span><span class=\"tok-punctuation\">;</span><span class=\"\"></span></div>\n<div>&nbsp;</div>\n<div><span class=\"\">    </span><span class=\"tok-keyword\">return</span><span class=\"\"> </span><span class=\"tok-punctuation\">{</span><span class=\"\"> </span><span class=\"tok-propertyName tok-definition\">left</span><span class=\"tok-punctuation\">,</span><span class=\"\"> </span><span class=\"tok-propertyName tok-definition\">top</span><span class=\"\"> </span><span class=\"tok-punctuation\">}</span><span class=\"tok-punctuation\">;</span><span class=\"\"></span></div>\n<div><span class=\"\">  </span><span class=\"tok-punctuation\">}</span><span class=\"\"></span></div>\n<div>&nbsp;</div>\n<div><span class=\"\">  </span><span class=\"tok-comment\">// recomputeCellPositions() asks for every cell's position again (starting at index 0)</span><span class=\"\"></span></div>\n<div><span class=\"\">  </span><span class=\"tok-comment\">// so the positioner's internal state must be reset before calling it</span><span class=\"\"></span></div>\n<div><span class=\"\">  </span><span class=\"tok-variableName\">cellPositioner</span><span class=\"tok-operator\">.</span><span class=\"tok-propertyName\">reset</span><span class=\"\"> </span><span class=\"tok-operator\">=</span><span class=\"\"> </span><span class=\"tok-punctuation\">(</span><span class=\"tok-punctuation\">)</span><span class=\"\"> </span><span class=\"tok-punctuation\">=&#62;</span><span class=\"\"> </span><span class=\"tok-punctuation\">{</span><span class=\"\"></span></div>\n<div><span class=\"\">    </span><span class=\"tok-variableName\">columnHeights</span><span class=\"\"> </span><span class=\"tok-operator\">=</span><span class=\"\"> </span><span class=\"tok-keyword\">new</span><span class=\"\"> </span><span class=\"tok-variableName\">Array</span><span class=\"\">&#60;</span><span class=\"tok-typeName\">number</span><span class=\"\">&#62;</span><span class=\"tok-punctuation\">(</span><span class=\"tok-variableName\">columnCount</span><span class=\"tok-punctuation\">)</span><span class=\"tok-operator\">.</span><span class=\"tok-propertyName\">fill</span><span class=\"tok-punctuation\">(</span><span class=\"tok-number\">0</span><span class=\"tok-punctuation\">)</span><span class=\"tok-punctuation\">;</span><span class=\"\"></span></div>\n<div><span class=\"\">  </span><span class=\"tok-punctuation\">}</span><span class=\"tok-punctuation\">;</span><span class=\"\"></span></div>\n<div>&nbsp;</div>\n<div><span class=\"\">  </span><span class=\"tok-keyword\">return</span><span class=\"\"> </span><span class=\"tok-variableName\">cellPositioner</span><span class=\"tok-punctuation\">;</span><span class=\"\"></span></div>\n<div><span class=\"\"></span><span class=\"tok-punctuation\">}</span></div>"
}