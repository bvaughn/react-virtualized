{
  "html": "<div><span class=\"tok-keyword\">import</span><span class=\"\"> </span><span class=\"tok-punctuation\">{</span><span class=\"\"> </span><span class=\"tok-variableName tok-definition\">CellMeasurerCache</span><span class=\"\"> </span><span class=\"tok-punctuation\">}</span><span class=\"\"> </span><span class=\"tok-keyword\">from</span><span class=\"\"> </span><span class=\"tok-string\">\"react-virtualized\"</span><span class=\"tok-punctuation\">;</span><span class=\"\"></span></div>\n<div>&nbsp;</div>\n<div><span class=\"\"></span><span class=\"tok-comment\">// Normally every cell is measured individually, which can be slow.</span><span class=\"\"></span></div>\n<div><span class=\"\"></span><span class=\"tok-comment\">// If all rows are known to have the same (but unknown) height,</span><span class=\"\"></span></div>\n<div><span class=\"\"></span><span class=\"tok-comment\">// a keyMapper that returns a constant tells CellMeasurer that</span><span class=\"\"></span></div>\n<div><span class=\"\"></span><span class=\"tok-comment\">// every measurement after the first one will hit the cache.</span><span class=\"\"></span></div>\n<div><span class=\"\"></span><span class=\"tok-keyword\">const</span><span class=\"\"> </span><span class=\"tok-variableName tok-definition\">cache</span><span class=\"\"> </span><span class=\"tok-operator\">=</span><span class=\"\"> </span><span class=\"tok-keyword\">new</span><span class=\"\"> </span><span class=\"tok-className\">CellMeasurerCache</span><span class=\"tok-punctuation\">(</span><span class=\"tok-punctuation\">{</span><span class=\"\"></span></div>\n<div><span class=\"\">  </span><span class=\"tok-propertyName tok-definition\">defaultHeight</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-number\">30</span><span class=\"tok-punctuation\">,</span><span class=\"\"></span></div>\n<div><span class=\"\">  </span><span class=\"tok-propertyName tok-definition\">fixedWidth</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-bool\">true</span><span class=\"tok-punctuation\">,</span><span class=\"\"></span></div>\n<div><span class=\"\">  </span><span class=\"tok-propertyName tok-definition\">keyMapper</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-punctuation\">(</span><span class=\"tok-punctuation\">)</span><span class=\"\"> </span><span class=\"tok-punctuation\">=&#62;</span><span class=\"\"> </span><span class=\"tok-number\">1</span><span class=\"\"></span></div>\n<div><span class=\"\"></span><span class=\"tok-punctuation\">}</span><span class=\"tok-punctuation\">)</span><span class=\"tok-punctuation\">;</span></div>"
}