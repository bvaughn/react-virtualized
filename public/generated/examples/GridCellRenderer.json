{
  "html": "<div><span class=\"tok-keyword\">import</span><span class=\"\"> </span><span class=\"tok-keyword\">type</span><span class=\"\"> </span><span class=\"tok-punctuation\">{</span><span class=\"\"> </span><span class=\"tok-variableName tok-definition\">CellRendererParams</span><span class=\"\"> </span><span class=\"tok-punctuation\">}</span><span class=\"\"> </span><span class=\"tok-keyword\">from</span><span class=\"\"> </span><span class=\"tok-string\">\"react-virtualized\"</span><span class=\"tok-punctuation\">;</span><span class=\"\"></span></div>\n<div>&nbsp;</div>\n<div><span class=\"\"></span><span class=\"tok-keyword\">function</span><span class=\"\"> </span><span class=\"tok-variableName tok-definition\">cellRenderer</span><span class=\"tok-punctuation\">(</span><span class=\"tok-punctuation\">{</span><span class=\"\"></span></div>\n<div><span class=\"\">  </span><span class=\"tok-propertyName\">columnIndex</span><span class=\"tok-punctuation\">,</span><span class=\"\"> </span><span class=\"tok-comment\">// Horizontal (column) index of cell</span><span class=\"\"></span></div>\n<div><span class=\"\">  </span><span class=\"tok-propertyName\">isScrolling</span><span class=\"tok-punctuation\">,</span><span class=\"\"> </span><span class=\"tok-comment\">// The Grid is currently being scrolled</span><span class=\"\"></span></div>\n<div><span class=\"\">  </span><span class=\"tok-propertyName\">key</span><span class=\"tok-punctuation\">,</span><span class=\"\"> </span><span class=\"tok-comment\">// Unique key within array of cells</span><span class=\"\"></span></div>\n<div><span class=\"\">  </span><span class=\"tok-propertyName\">rowIndex</span><span class=\"tok-punctuation\">,</span><span class=\"\"> </span><span class=\"tok-comment\">// Vertical (row) index of cell</span><span class=\"\"></span></div>\n<div><span class=\"\">  </span><span class=\"tok-propertyName\">style</span><span class=\"\"> </span><span class=\"tok-comment\">// Style object to be applied to cell (to position it)</span><span class=\"\"></span></div>\n<div><span class=\"\">  </span><span class=\"tok-comment\">// Also available:</span><span class=\"\"></span></div>\n<div><span class=\"\">  </span><span class=\"tok-comment\">// isVisible: This cell is visible within the grid (eg it is not an overscanned cell)</span><span class=\"\"></span></div>\n<div><span class=\"\">  </span><span class=\"tok-comment\">// parent: Reference to the parent Grid (instance)</span><span class=\"\"></span></div>\n<div><span class=\"\"></span><span class=\"tok-punctuation\">}</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-typeName\">CellRendererParams</span><span class=\"tok-punctuation\">)</span><span class=\"\"> </span><span class=\"tok-punctuation\">{</span><span class=\"\"></span></div>\n<div><span class=\"\">  </span><span class=\"tok-keyword\">const</span><span class=\"\"> </span><span class=\"tok-variableName tok-definition\">user</span><span class=\"\"> </span><span class=\"tok-operator\">=</span><span class=\"\"> </span><span class=\"tok-variableName\">list</span><span class=\"tok-punctuation\">[</span><span class=\"tok-variableName\">rowIndex</span><span class=\"tok-punctuation\">]</span><span class=\"tok-punctuation\">[</span><span class=\"tok-variableName\">columnIndex</span><span class=\"tok-punctuation\">]</span><span class=\"tok-punctuation\">;</span><span class=\"\"></span></div>\n<div>&nbsp;</div>\n<div><span class=\"\">  </span><span class=\"tok-comment\">// If cell content is complex, consider rendering a lighter-weight placeholder while scrolling</span><span class=\"\"></span></div>\n<div><span class=\"\">  </span><span class=\"tok-keyword\">const</span><span class=\"\"> </span><span class=\"tok-variableName tok-definition\">content</span><span class=\"\"> </span><span class=\"tok-operator\">=</span><span class=\"\"> </span><span class=\"tok-variableName\">isScrolling</span><span class=\"\"> </span><span class=\"tok-operator\">?</span><span class=\"\"> </span><span class=\"tok-string\">\"...\"</span><span class=\"\"> </span><span class=\"tok-operator\">:</span><span class=\"\"> </span><span class=\"tok-punctuation\">&#60;</span><span class=\"tok-typeName\">User</span><span class=\"\"> </span><span class=\"tok-propertyName\">user</span><span class=\"tok-operator\">=</span><span class=\"tok-punctuation\">{</span><span class=\"tok-variableName\">user</span><span class=\"tok-punctuation\">}</span><span class=\"\"> </span><span class=\"tok-punctuation\">/&#62;</span><span class=\"tok-punctuation\">;</span><span class=\"\"></span></div>\n<div>&nbsp;</div>\n<div><span class=\"\">  </span><span class=\"tok-comment\">// Style is required since it specifies how the cell is to be sized and positioned;</span><span class=\"\"></span></div>\n<div><span class=\"\">  </span><span class=\"tok-comment\">// Grid depends on this sizing/positioning for proper scrolling behavior.</span><span class=\"\"></span></div>\n<div><span class=\"\">  </span><span class=\"tok-comment\">// By default it contains position, left, top, height, and width properties.</span><span class=\"\"></span></div>\n<div><span class=\"\">  </span><span class=\"tok-comment\">// You can add class names or style properties as you like (but don't mutate the object).</span><span class=\"\"></span></div>\n<div><span class=\"\">  </span><span class=\"tok-comment\">// Key is also required by React to more efficiently manage the array of cells.</span><span class=\"\"></span></div>\n<div><span class=\"\">  </span><span class=\"tok-keyword\">return</span><span class=\"\"> </span><span class=\"tok-punctuation\">(</span><span class=\"\"></span></div>\n<div><span class=\"\">    </span><span class=\"tok-punctuation\">&#60;</span><span class=\"tok-typeName\">div</span><span class=\"\"> </span><span class=\"tok-propertyName\">key</span><span class=\"tok-operator\">=</span><span class=\"tok-punctuation\">{</span><span class=\"tok-variableName\">key</span><span class=\"tok-punctuation\">}</span><span class=\"\"> </span><span class=\"tok-propertyName\">style</span><span class=\"tok-operator\">=</span><span class=\"tok-punctuation\">{</span><span class=\"tok-variableName\">style</span><span class=\"tok-punctuation\">}</span><span class=\"tok-punctuation\">&#62;</span><span class=\"\"></span></div>\n<div><span class=\"\">      </span><span class=\"tok-punctuation\">{</span><span class=\"tok-variableName\">content</span><span class=\"tok-punctuation\">}</span><span class=\"\"></span></div>\n<div><span class=\"\">    </span><span class=\"tok-punctuation\">&#60;/</span><span class=\"tok-typeName\">div</span><span class=\"tok-punctuation\">&#62;</span><span class=\"\"></span></div>\n<div><span class=\"\">  </span><span class=\"tok-punctuation\">)</span><span class=\"tok-punctuation\">;</span><span class=\"\"></span></div>\n<div><span class=\"\"></span><span class=\"tok-punctuation\">}</span></div>"
}