{
  "html": "<div><span class=\"tok-comment\">// Smoothly scrolls the window to a row of a List with scrollElement=\"window\".</span><span class=\"\"></span></div>\n<div><span class=\"\"></span><span class=\"tok-comment\">// (listElementRef is passed to the List's elementRef prop.)</span><span class=\"\"></span></div>\n<div><span class=\"\"></span><span class=\"tok-keyword\">function</span><span class=\"\"> </span><span class=\"tok-variableName tok-definition\">smoothScrollToRow</span><span class=\"tok-punctuation\">(</span><span class=\"tok-variableName tok-definition\">index</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-typeName\">number</span><span class=\"tok-punctuation\">)</span><span class=\"\"> </span><span class=\"tok-punctuation\">{</span><span class=\"\"></span></div>\n<div><span class=\"\">  </span><span class=\"tok-keyword\">const</span><span class=\"\"> </span><span class=\"tok-variableName tok-definition\">list</span><span class=\"\"> </span><span class=\"tok-operator\">=</span><span class=\"\"> </span><span class=\"tok-variableName\">listRef</span><span class=\"tok-operator\">.</span><span class=\"tok-propertyName\">current</span><span class=\"tok-punctuation\">;</span><span class=\"\"></span></div>\n<div><span class=\"\">  </span><span class=\"tok-keyword\">const</span><span class=\"\"> </span><span class=\"tok-variableName tok-definition\">listElement</span><span class=\"\"> </span><span class=\"tok-operator\">=</span><span class=\"\"> </span><span class=\"tok-variableName\">listElementRef</span><span class=\"tok-operator\">.</span><span class=\"tok-propertyName\">current</span><span class=\"tok-punctuation\">;</span><span class=\"\"></span></div>\n<div><span class=\"\">  </span><span class=\"tok-keyword\">if</span><span class=\"\"> </span><span class=\"tok-punctuation\">(</span><span class=\"tok-variableName\">list</span><span class=\"\"> </span><span class=\"tok-operator\">&#38;&#38;</span><span class=\"\"> </span><span class=\"tok-variableName\">listElement</span><span class=\"tok-punctuation\">)</span><span class=\"\"> </span><span class=\"tok-punctuation\">{</span><span class=\"\"></span></div>\n<div><span class=\"\">    </span><span class=\"tok-comment\">// Offset of the row within the List, and of the List within the page</span><span class=\"\"></span></div>\n<div><span class=\"\">    </span><span class=\"tok-keyword\">const</span><span class=\"\"> </span><span class=\"tok-variableName tok-definition\">rowOffset</span><span class=\"\"> </span><span class=\"tok-operator\">=</span><span class=\"\"> </span><span class=\"tok-variableName\">list</span><span class=\"tok-operator\">.</span><span class=\"tok-propertyName\">getOffsetForRow</span><span class=\"tok-punctuation\">(</span><span class=\"tok-punctuation\">{</span><span class=\"\"> </span><span class=\"tok-propertyName tok-definition\">align</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-string\">\"start\"</span><span class=\"tok-punctuation\">,</span><span class=\"\"> </span><span class=\"tok-propertyName tok-definition\">index</span><span class=\"\"> </span><span class=\"tok-punctuation\">}</span><span class=\"tok-punctuation\">)</span><span class=\"tok-punctuation\">;</span><span class=\"\"></span></div>\n<div><span class=\"\">    </span><span class=\"tok-keyword\">const</span><span class=\"\"> </span><span class=\"tok-variableName tok-definition\">listOffset</span><span class=\"\"> </span><span class=\"tok-operator\">=</span><span class=\"\"> </span><span class=\"tok-variableName\">listElement</span><span class=\"tok-operator\">.</span><span class=\"tok-propertyName\">getBoundingClientRect</span><span class=\"tok-punctuation\">(</span><span class=\"tok-punctuation\">)</span><span class=\"tok-operator\">.</span><span class=\"tok-propertyName\">top</span><span class=\"\"> </span><span class=\"tok-operator\">+</span><span class=\"\"> </span><span class=\"tok-variableName\">window</span><span class=\"tok-operator\">.</span><span class=\"tok-propertyName\">scrollY</span><span class=\"tok-punctuation\">;</span><span class=\"\"></span></div>\n<div>&nbsp;</div>\n<div><span class=\"\">    </span><span class=\"tok-variableName\">window</span><span class=\"tok-operator\">.</span><span class=\"tok-propertyName\">scrollTo</span><span class=\"tok-punctuation\">(</span><span class=\"tok-punctuation\">{</span><span class=\"\"> </span><span class=\"tok-propertyName tok-definition\">behavior</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-string\">\"smooth\"</span><span class=\"tok-punctuation\">,</span><span class=\"\"> </span><span class=\"tok-propertyName tok-definition\">top</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">listOffset</span><span class=\"\"> </span><span class=\"tok-operator\">+</span><span class=\"\"> </span><span class=\"tok-variableName\">rowOffset</span><span class=\"\"> </span><span class=\"tok-punctuation\">}</span><span class=\"tok-punctuation\">)</span><span class=\"tok-punctuation\">;</span><span class=\"\"></span></div>\n<div><span class=\"\">  </span><span class=\"tok-punctuation\">}</span><span class=\"\"></span></div>\n<div><span class=\"\"></span><span class=\"tok-punctuation\">}</span></div>"
}