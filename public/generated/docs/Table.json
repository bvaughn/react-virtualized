        {
          "content": "<p>Callback invoked whenever the scroll offset changes within the inner scrollable region:\n<code>({ clientHeight: number, scrollHeight: number, scrollTop: number }): void</code>.\nThis callback can be used to sync scrolling between lists, tables, or grids.</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\"><span class=\"tok-propertyName\">onScroll</span></span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-punctuation\">(</span><span class=\"tok-variableName tok-definition\">params</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-typeName\">TableScrollParams</span><span class=\"tok-punctuation\">)</span><span class=\"\"> </span><span class=\"tok-punctuation\">=&#62;</span><span class=\"\"> </span><span class=\"tok-keyword\">void</span></div>",
      "name": "onScroll",
      "required": false
    },
    "overscanIndicesGetter": {
      "description": [
        {
          "content": "<p>Responsible for calculating the number of rows to overscan before and after a specified range (see <code>Grid</code> <code>overscanIndicesGetter</code>).\nBy default (<code>accessibilityOverscanIndicesGetter</code>), <code>Table</code> overscans by at least one row in each direction (for accessibility).</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\"><span class=\"tok-propertyName\">overscanIndicesGetter</span></span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">OverscanIndicesGetter</span></div>",
      "name": "overscanIndicesGetter",
      "required": false
    },
    "overscanRowCount": {
      "description": [
        {
          "content": "<p>Number of rows to render above/below the visible bounds of the list.\nThis can help reduce flickering during scrolling on certain browsers/devices.</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\"><span class=\"tok-propertyName\">overscanRowCount</span></span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">number</span><span class=\"\"> </span><span class=\"tok-operator\">=</span><span class=\"\"> </span><span class=\"tok-number\">10</span></div>",
      "name": "overscanRowCount",
      "required": false
    },
    "rowClassName": {
      "description": [
        {
          "content": "<p>Optional CSS class to apply to all table rows (including the header row).\nThis value may be either a static string or a function with the signature <code>({ index: number }): string</code>.\nNote that for the header row an index of <code>-1</code> is provided.</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\"><span class=\"tok-propertyName\">rowClassName</span></span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">string</span><span class=\"\"> </span><span class=\"tok-operator\">|</span><span class=\"\"> </span><span class=\"tok-punctuation\">(</span><span class=\"tok-punctuation\">(</span><span class=\"tok-variableName tok-definition\">params</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-punctuation\">{</span><span class=\"\"> </span><span class=\"tok-propertyName tok-definition\">index</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-typeName\">number</span><span class=\"tok-punctuation\">;</span><span class=\"\"> </span><span class=\"tok-punctuation\">}</span><span class=\"tok-punctuation\">)</span><span class=\"\"> </span><span class=\"tok-punctuation\">=&#62;</span><span class=\"\"> </span><span class=\"tok-variableName\">string</span><span class=\"tok-punctuation\">)</span></div>",
      "name": "rowClassName",
      "required": false
    },
    "rowCount": {
      "description": [
        {
          "content": "<p>Number of rows in table.</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-labelName\"><span class=\"tok-propertyName\">rowCount</span></span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">number</span></div>",
      "name": "rowCount",
      "required": true
    },
    "rowGetter": {
      "description": [
        {
          "content": "<p>Callback responsible for returning a data row given an index:\n<code>({ index: number }): any</code>.</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-labelName\"><span class=\"tok-propertyName\">rowGetter</span></span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-punctuation\">(</span><span class=\"tok-variableName tok-definition\">params</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-punctuation\">{</span><span class=\"\"> </span><span class=\"tok-propertyName tok-definition\">index</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-typeName\">number</span><span class=\"tok-punctuation\">;</span><span class=\"\"> </span><span class=\"tok-punctuation\">}</span><span class=\"tok-punctuation\">)</span><span class=\"\"> </span><span class=\"tok-punctuation\">=&#62;</span><span class=\"\"> </span><span class=\"tok-variableName\">any</span></div>",
      "name": "rowGetter",
      "required": true
    },
    "rowHeight": {
      "description": [
        {
          "content": "<p>Either a fixed row height (number) or a function that returns the height of a row given its index:\n<code>({ index: number }): number</code>.</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-labelName\"><span class=\"tok-propertyName\">rowHeight</span></span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">CellSize</span></div>",
      "name": "rowHeight",
      "required": true
    },
    "rowRenderer": {
      "description": [
        {
          "content": "<p>Responsible for rendering a table row given an array of columns.</p>\n"
        },
        {
          "content": "<p>This is an advanced property.\nIt is useful for situations where you require additional hooks into <code>Table</code> (eg integration with a library like <code>react-sortable-hoc</code>).\nThe easiest way to override it is to decorate (or fork) the <code>defaultTableRowRenderer</code> function (the default).</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\"><span class=\"tok-propertyName\">rowRenderer</span></span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">TableRowRenderer</span></div>",
      "name": "rowRenderer",
      "required": false
    },
    "rowStyle": {
      "description": [
        {
          "content": "<p>Optional custom inline style to attach to table rows (including the header row).\nThis value may be either a style object or a function with the signature <code>({ index: number }): CSSProperties</code>.\nNote that for the header row an index of <code>-1</code> is provided.</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\"><span class=\"tok-propertyName\">rowStyle</span></span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">CSSProperties</span><span class=\"\"> </span><span class=\"tok-operator\">|</span><span class=\"\"> </span><span class=\"tok-punctuation\">(</span><span class=\"tok-punctuation\">(</span><span class=\"tok-variableName tok-definition\">params</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-punctuation\">{</span><span class=\"\"> </span><span class=\"tok-propertyName tok-definition\">index</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-typeName\">number</span><span class=\"tok-punctuation\">;</span><span class=\"\"> </span><span class=\"tok-punctuation\">}</span><span class=\"tok-punctuation\">)</span><span class=\"\"> </span><span class=\"tok-punctuation\">=&#62;</span><span class=\"\"> </span><span class=\"tok-variableName\">CSSProperties</span><span class=\"tok-punctuation\">)</span><span class=\"\"> </span><span class=\"tok-operator\">=</span><span class=\"\"> </span><span class=\"tok-punctuation\">{</span><span class=\"tok-punctuation\">}</span></div>",
      "name": "rowStyle",
      "required": false
    },
    "sort": {
      "description": [
        {
          "content": "<p>Sort function to be called if a sortable header is clicked:\n<code>({ defaultSortDirection: SortDirection, event: Event, sortBy: string, sortDirection: SortDirection }): void</code>.</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\"><span class=\"tok-propertyName\">sort</span></span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-punctuation\">(</span><span class=\"tok-variableName tok-definition\">params</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-typeName\">TableSortParams</span><span class=\"tok-punctuation\">)</span><span class=\"\"> </span><span class=\"tok-punctuation\">=&#62;</span><span class=\"\"> </span><span class=\"tok-keyword\">void</span></div>",
      "name": "sort",
      "required": false
    },
    "sortBy": {
      "description": [
        {
          "content": "<p>Data is currently sorted by this <code>dataKey</code> (if it is sorted at all).</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\"><span class=\"tok-propertyName\">sortBy</span></span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">string</span></div>",
      "name": "sortBy",
      "required": false
    },
    "sortDirection": {
      "description": [
        {
          "content": "<p>Data is currently sorted in this direction (if it is sorted at all).</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\"><span class=\"tok-propertyName\">sortDirection</span></span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">SortDirectionType</span></div>",
      "name": "sortDirection",
      "required": false
    },
    "scrollElement": {
      "description": [
        {
          "content": "<p>Element that scrolls the <code>Table</code> (instead of the <code>Table</code> scrolling itself): <code>&quot;window&quot;</code>, or a scrollable DOM element\n(e.g. a container that the <code>Table</code> is rendered within, along with other content).</p>\n"
        },
        {
          "content": "<p>The <code>Table</code> then renders all of its rows at their full height (below its header, which scrolls along with them), renders only the rows visible within the scroll element's viewport,\nand its scroll methods scroll the scroll element.\nIts position within the scroll element is measured when the scroll element scrolls or is resized, and when the <code>Table</code> re-renders\n(e.g. call <code>forceUpdateGrid()</code> if content above the <code>Table</code> changes size without the <code>Table</code> re-rendering).\nPass <code>null</code> while the scroll element isn't available yet (e.g. before a ref to it has been attached);\nthe <code>Table</code> then renders the rows at its top.</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\"><span class=\"tok-propertyName\">scrollElement</span></span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">ScrollElement</span><span class=\"\"> </span><span class=\"tok-operator\">|</span><span class=\"\"> </span><span class=\"tok-keyword\">null</span></div>",
      "name": "scrollElement",
      "required": false
    },
    "style": {
      "description": [
        {
          "content": "<p>Optional custom inline style to attach to root <code>Table</code> element.</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\"><span class=\"tok-propertyName\">style</span></span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">CSSProperties</span><span class=\"\"> </span><span class=\"tok-operator\">=</span><span class=\"\"> </span><span class=\"tok-punctuation\">{</span><span class=\"tok-punctuation\">}</span></div>",
      "name": "style",
      "required": false
    },
    "tabIndex": {
      "description": [
        {
          "content": "<p>Optional override of inner <code>Grid</code> tab index default.</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\"><span class=\"tok-propertyName\">tabIndex</span></span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">number</span><span class=\"\"> </span><span class=\"tok-operator\">|</span><span class=\"\"> </span><span class=\"tok-keyword\">null</span><span class=\"\"> </span><span class=\"tok-operator\">=</span><span class=\"\"> </span><span class=\"tok-number\">0</span></div>",
      "name": "tabIndex",
      "required": false
    },
    "width": {
      "description": [
        {
          "content": "<p>Width of the table.</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-labelName\"><span class=\"tok-propertyName\">width</span></span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">number</span></div>",
      "name": "width",
      "required": true
    }
  }
}