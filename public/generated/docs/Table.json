    "height": {
      "description": [
        {
          "content": "<p>Fixed/available height for the outer DOM element.\nRequired, unless a <code>scrollElement</code> is specified.</p>\n"
        },
        {
          "content": "<p>With a <code>scrollElement</code>, the height of the scroll element's viewport is used instead;\nthis prop is then only used until the scroll element has been measured (e.g. during server rendering).</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\"><span class=\"tok-propertyName\">height</span></span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">number</span></div>",
      "name": "height",
      "required": false
    },
    "id": {
      "description": [
        {
          "content": "<p>Optional custom id to attach to root <code>Table</code> element.</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\"><span class=\"tok-propertyName\">id</span></span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">string</span></div>",
      "name": "id",
      "required": false
    },
    "initialScrollTop": {
      "description": [
        {
          "content": "<p>Vertical scroll offset to initially render (and scroll to) the <code>Table</code> at.\nOnly the initial value is used: changing this prop later has no effect (use <code>scrollToPosition</code> to scroll).\nThis also works with server rendering: the rows at this offset are rendered on the server,\nand they stay in place when the page is hydrated.\nIgnored if a <code>scrollElement</code> is specified (which then determines the vertical offset).</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\"><span class=\"tok-propertyName\">initialScrollTop</span></span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">number</span></div>",
      "name": "initialScrollTop",
      "required": false
    },
    "noRowsRenderer": {
