{
  "description": [
    {
      "content": "<p>Table component with fixed headers and virtualized rows for improved performance with large data sets.\nThis component expects explicit width, height, and padding parameters.</p>\n"
    },
    {
      "content": "<p>Columns are described by <code>Column</code> children (or components that render a <code>Column</code>).\nScrolling is done through the imperative handle (<code>ref</code>): see <code>scrollToRow</code>, <code>scrollToCell</code>, and <code>scrollToPosition</code>.</p>\n"
    }
  ],
  "filePath": "lib/components/Table/Table.tsx",
  "name": "Table",
  "props": {
    "cellRangeRenderer": {
      "description": [
        {
          "content": "<p>Responsible for rendering a group of cells given their index ranges.</p>\n"
        },
        {
          "content": "<p>This is an advanced property.\nIt is useful for situations where the <code>Grid</code> requires additional, overlayed UI (such as a Gantt chart or a calendar application).\nThe easiest way to override it is to decorate <code>defaultCellRangeRenderer</code>.</p>\n"
        },
        {
          "content": "<p>Defaults to <code>defaultCellRangeRenderer</code>.</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\"><span class=\"tok-propertyName\">cellRangeRenderer</span></span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">CellRangeRenderer</span></div>",
      "name": "cellRangeRenderer",
      "required": false
    },
    "containerProps": {
      "description": [
        {
          "content": "<p>Additional props (eg <code>onWheel</code>) to spread onto the outer <code>Grid</code> element.</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\"><span class=\"tok-propertyName\">containerProps</span></span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">HTMLAttributes</span><span class=\"\">&#60;</span><span class=\"tok-typeName\">HTMLDivElement</span><span class=\"\">&#62;</span></div>",
      "name": "containerProps",
      "required": false
    },
    "containerRole": {
      "description": [
        {
          "content": "<p>ARIA role for the inner cell-container.</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\"><span class=\"tok-propertyName\">containerRole</span></span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">string</span><span class=\"\"> </span><span class=\"tok-operator\">=</span><span class=\"\"> </span><span class=\"tok-string\">\"row\"</span></div>",
      "name": "containerRole",
      "required": false
    },
    "containerStyle": {
      "description": [
        {
          "content": "<p>Optional custom inline style to attach to inner cell-container element.</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\"><span class=\"tok-propertyName\">containerStyle</span></span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">CSSProperties</span><span class=\"\"> </span><span class=\"tok-operator\">=</span><span class=\"\"> </span><span class=\"tok-punctuation\">{</span><span class=\"tok-punctuation\">}</span></div>",
      "name": "containerStyle",
      "required": false
    },
    "getScrollbarSize": {
      "description": [
        {
          "content": "<p>Returns the size of the browser's scrollbar.\nExposed for testing purposes only.</p>\n"
        },
        {
          "content": "<p>Defaults to <code>dom-helpers</code>' <code>scrollbarSize</code> (which returns <code>undefined</code> during server rendering).</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\"><span class=\"tok-propertyName\">getScrollbarSize</span></span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-punctuation\">(</span><span class=\"tok-punctuation\">)</span><span class=\"\"> </span><span class=\"tok-punctuation\">=&#62;</span><span class=\"\"> </span><span class=\"tok-variableName\">number</span></div>",
      "name": "getScrollbarSize",
      "required": false
    },
    "isScrollingOptOut": {
      "description": [
        {
          "content": "<p>Prevents re-rendering of visible cells on scroll end.\n(Opts out of the isScrolling param passed to cellRangeRenderer, to avoid the extra render when scroll stops.)\nVisible cells are still re-rendered when the <code>Grid</code>'s props change or <code>forceUpdate()</code> is called.</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\"><span class=\"tok-propertyName\">isScrollingOptOut</span></span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">boolean</span><span class=\"\"> </span><span class=\"tok-operator\">=</span><span class=\"\"> </span><span class=\"tok-bool\">false</span></div>",
      "name": "isScrollingOptOut",
      "required": false
    },
    "onScrollbarPresenceChange": {
      "description": [
        {
          "content": "<p>Called whenever a horizontal or vertical scrollbar is added or removed:\n<code>({ horizontal: boolean, size: number, vertical: boolean }): void</code>.\nThis prop is not intended for end-user use;\nit is used by MultiGrid to support fixed-row/fixed-column scroll syncing.</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\"><span class=\"tok-propertyName\">onScrollbarPresenceChange</span></span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-punctuation\">(</span><span class=\"tok-variableName tok-definition\">params</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-typeName\">ScrollbarPresenceChange</span><span class=\"tok-punctuation\">)</span><span class=\"\"> </span><span class=\"tok-punctuation\">=&#62;</span><span class=\"\"> </span><span class=\"tok-keyword\">void</span></div>",
      "name": "onScrollbarPresenceChange",
      "required": false
    },
    "scrollingResetTimeInterval": {
      "description": [
        {
          "content": "<p>Wait this amount of time (in milliseconds) after the last scroll event before resetting Grid <code>pointer-events</code>.</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\"><span class=\"tok-propertyName\">scrollingResetTimeInterval</span></span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">number</span><span class=\"\"> </span><span class=\"tok-operator\">=</span><span class=\"\"> </span><span class=\"tok-number\">150</span></div>",
      "name": "scrollingResetTimeInterval",
      "required": false
    },
    "aria-label": {
      "description": [
        {
          "content": "<p>ARIA label set on the outer <code>Table</code> element.</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\"><span class=\"tok-propertyName\">aria-label</span></span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">string</span></div>",
      "name": "aria-label",
      "required": false
    },
    "aria-labelledby": {
      "description": [
        {
          "content": "<p>ARIA labelledby attribute set on the outer <code>Table</code> element.</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\"><span class=\"tok-propertyName\">aria-labelledby</span></span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">string</span></div>",
      "name": "aria-labelledby",
      "required": false
    },
    "children": {
      "description": [
        {
          "content": "<p>One or more <code>Column</code>s describing the data displayed in this table.\nFalsy children are ignored, to allow easier dynamic showing/hiding of columns.</p>\n"
        },
        {
          "content": "<p><code>Table</code> reads the props of its children (with <code>defaultColumnProps</code> applied) without rendering them,\nso components that wrap <code>Column</code> (e.g. <code>const MyColumn = (props: ColumnProps) =&gt; &lt;Column {...props} /&gt;</code>) can be used as children too.\n(Subclassing <code>Column</code> is no longer supported.)</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\"><span class=\"tok-propertyName\">children</span></span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">ReactNode</span></div>",
      "name": "children",
      "required": false
    },
    "className": {
      "description": [
        {
          "content": "<p>Optional custom CSS class name to attach to root <code>Table</code> element.</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\"><span class=\"tok-propertyName\">className</span></span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">string</span></div>",
      "name": "className",
      "required": false
    },
    "deferredMeasurementCache": {
      "description": [
        {
          "content": "<p>If <code>CellMeasurer</code> is used to measure this Table's cells, this should be a pointer to its <code>CellMeasurerCache</code>.\nIt is passed through to the inner <code>Grid</code>.</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\"><span class=\"tok-propertyName\">deferredMeasurementCache</span></span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">CellMeasureCache</span></div>",
      "name": "deferredMeasurementCache",
      "required": false
    },
    "disableHeader": {
      "description": [
        {
          "content": "<p>Do not render the table header (only the rows).</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\"><span class=\"tok-propertyName\">disableHeader</span></span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">boolean</span><span class=\"\"> </span><span class=\"tok-operator\">=</span><span class=\"\"> </span><span class=\"tok-bool\">false</span></div>",
