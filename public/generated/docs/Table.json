        {
          "content": "<p>Optional custom inline style to attach to table header columns.</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\"><span class=\"tok-propertyName\">headerStyle</span></span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">CSSProperties</span><span class=\"\"> </span><span class=\"tok-operator\">=</span><span class=\"\"> </span><span class=\"tok-punctuation\">{</span><span class=\"tok-punctuation\">}</span></div>",
