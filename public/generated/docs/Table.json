      "html": "<div><span class=\"tok-variableName\"><span class=\"tok-propertyName\">estimatedRowSize</span></span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">number</span><span class=\"\"> </span><span class=\"tok-operator\">=</span><span class=\"\"> </span><span class=\"tok-number\">30</span></div>",
      "name": "estimatedRowSize",
      "required": false
    },
    "gridClassName": {
