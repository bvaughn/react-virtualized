    "width": {
      "description": [
        {
          "content": "<p>Flex basis (width) for this column;\nThis value can grow or shrink based on <code>flexGrow</code> and <code>flexShrink</code> properties.</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-labelName\"><span class=\"tok-propertyName\">width</span></span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">number</span></div>",
      "name": "width",
      "required": true
    }
  }
}