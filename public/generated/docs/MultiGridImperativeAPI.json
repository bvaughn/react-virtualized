    {
      "description": [
        {
          "content": "<p>Invalidate the size of a cell (after the current render has been committed); see <code>Grid#invalidateCellSizeAfterRender</code>.\nThe invalidated cells (of all child <code>Grid</code>s) are recomputed, and the <code>MultiGrid</code> re-rendered, once the current render has been committed.\nThis method is intended for <code>CellMeasurer</code>.</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\">invalidateCellSizeAfterRender</span><span class=\"tok-punctuation\">(</span><span class=\"tok-variableName\">params</span><span class=\"tok-operator\">?</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-variableName\">Partial</span><span class=\"\">&#60;</span><span class=\"tok-typeName\">CellPosition</span><span class=\"\">&#62;)</span><span class=\"tok-operator\">:</span><span class=\"\"> </span><span class=\"tok-keyword\">void</span><span class=\"tok-punctuation\">;</span></div>",
      "name": "invalidateCellSizeAfterRender"
    },
    {
      "description": [
        {
          "content": "<p>Pass-thru that calls <code>measureAllCells</code> on all child <code>Grid</code>s.</p>\n"
        }
      ],
      "html": "<div><span class=\"tok-variableName\">measureAllCells</span><span class=\"tok-punctuation\">(</span><span class=\"tok-punctuation\">)</span><span class=\"tok-punctuation\">:</span><span class=\"\"> </span><span class=\"tok-keyword\">void</span><span class=\"tok-punctuation\">;</span></div>",
